{
  "expo": {
    "name": "PPSI",
    "slug": "ppsi",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ppsi.aplikasi",
      "buildNumber": "6"
    },
    "android": {
      "versionCode": 6,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ppsi.aplikasi"
    },
    "extra": {
      "eas": {
        "projectId": "ppsi-mobile"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
