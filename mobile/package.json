{
  "name": "ppsi-mobile",
  "version": "1.3.1",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "eas build --platform android --profile preview",
    "build:bundle": "eas build --platform android --profile production",
    "build:apk:local": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease",
    "build:bundle:local": "cd android && ./gradlew bundleRelease",
    "generate:assets": "node scripts/generate-assets.mjs",
    "generate:store-assets": "node scripts/generate-store-assets.mjs",
    "generate:all-assets": "node scripts/generate-all-formfactors.mjs"
  },
  "dependencies": {
    "expo": "^53.0.0",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-font": "~13.3.2",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~13.0.0",
    "sharp": "^0.33.5"
  },
  "private": true
}
